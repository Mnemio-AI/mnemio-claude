{
  "mcpServers": {
    "mnemio": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/channel.mjs"],
      "env": {
        "MNEMIO_URL": "${MNEMIO_URL:-}",
        "MNEMIO_TOKEN": "${MNEMIO_TOKEN:-}",
        "MNEMIO_CHANNEL": "${MNEMIO_CHANNEL:-}"
      }
    },
    "mnemio-tools": {
      "type": "http",
      "url": "${MNEMIO_URL:-http://localhost:8787}/api/claude/mcp",
      "headers": { "Authorization": "Bearer ${MNEMIO_TOKEN:-}" }
    },
    "mnemio-apps": {
      "type": "http",
      "url": "${MNEMIO_URL:-http://localhost:8787}/api/claude/apps/mcp",
      "headers": { "Authorization": "Bearer ${MNEMIO_TOKEN:-}" }
    }
  }
}
